# Nord VTC — variables d'environnement.
# Sur Cloudflare : Worker nordvtc > Settings.
#  - [BUILD]   = Settings > Build > Variables and secrets (lues à la compilation : toute variable NEXT_PUBLIC_*)
#  - [RUNTIME] = Settings > Variables and secrets (type « Secret » pour les clés)
# Après tout changement [BUILD], relancer un déploiement (Deployments > Retry build).

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://nordvtc.fr            # [BUILD]
NEXT_PUBLIC_CONTACT_EMAIL=                          # [BUILD] e-mail affiché sur le site
NEXT_PUBLIC_BUSINESS_ADDRESS=                       # [BUILD]
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=                       # [BUILD] optionnel (statistiques)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=                           # [BUILD]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                      # [BUILD]
SUPABASE_SERVICE_ROLE_KEY=                          # [RUNTIME, Secret]

# --- Administration et signatures ---
ADMIN_PASSWORD=                                     # [RUNTIME, Secret] mot de passe de l'admin
ADMIN_SESSION_SECRET=                               # [RUNTIME, Secret] 24 caractères minimum, aléatoire
CALLBACK_SECRET=                                    # [RUNTIME, Secret] optionnel (sinon dérivé de ADMIN_SESSION_SECRET)

# --- Adresses et prix ---
HERE_API_KEY=                                       # [RUNTIME, Secret]
GOOGLE_PLACES_API_KEY=                              # [RUNTIME, Secret] optionnel (avis)
GOOGLE_PLACE_ID=                                    # [RUNTIME] optionnel

# --- E-mails (Resend) ---
RESEND_API_KEY=                                     # [RUNTIME, Secret]
MAIL_FROM=                                          # [RUNTIME] ex. Nord VTC <reservation@nordvtc.fr>
MAIL_NOTIFY_TO=                                     # [RUNTIME] où recevoir les réservations
DRIVER_PHONE=                                       # [RUNTIME, Secret] numéro du chauffeur, jamais exposé côté client

# --- Paiement (Stripe) ---
STRIPE_SECRET_KEY=                                  # [RUNTIME, Secret]
STRIPE_WEBHOOK_SECRET=                              # [RUNTIME, Secret] webhook : https://nordvtc.fr/api/stripe/webhook

# --- SMS (Twilio Verify) ---
TWILIO_ACCOUNT_SID=                                 # [RUNTIME, Secret]
TWILIO_AUTH_TOKEN=                                  # [RUNTIME, Secret]
TWILIO_VERIFY_SID=                                  # [RUNTIME, Secret]

# --- Anti-spam (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITEKEY=                      # [BUILD]
TURNSTILE_SECRET=                                   # [RUNTIME, Secret]
